# LLM
ANTHROPIC_API_KEY=your_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Redis
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@localhost:6379/0

# ChromaDB (legacy storage; scheduled to be replaced by Qdrant)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Qdrant RAG
QDRANT_URL=http://localhost:6333
RAG_DENSE_MODEL=BAAI/bge-small-zh-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_MODEL_CACHE_DIR=./data/models
# BGE reranker 原始 logit 的初始决策边界；使用固定测试集校准后再调整。
RAG_SUFFICIENCY_THRESHOLD=0.0
RAG_TIMEOUT_S=90

# Monitoring
PROMETHEUS_PORT=9090
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
